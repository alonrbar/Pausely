<Window Style="{StaticResource FramelessWindow}" x:Class="Pausely.Views.SetTimeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pausely · Set Time" Width="438" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="98" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" /></WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="Stepper" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="Delay" Value="400"/><Setter Property="Interval" Value="80"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border x:Name="Surface" Background="#E8EEE4" CornerRadius="4" Margin="0,1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DBE3D8"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#BDCFBE"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <StackPanel Margin="28">
    <Grid><TextBlock Text="Set time" FontSize="27" FontWeight="SemiBold"/><Button Content="×" Style="{StaticResource WindowControl}" HorizontalAlignment="Right" Click="Cancel_Click" ToolTip="Cancel" AutomationProperties.Name="Cancel time adjustment"/></Grid>
    <TextBlock Text="Adjust this countdown only. Your settings stay the same." Foreground="{StaticResource Muted}" Margin="0,10,0,20" />
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel>
        <Label Content="_Minutes" Target="{Binding ElementName=MinutesInput}"/>
        <Grid>
          <TextBox x:Name="MinutesInput" FontSize="24" MaxLength="3" Padding="10,8,38,8" PreviewKeyDown="TimeInput_KeyDown" AutomationProperties.Name="Minutes remaining"/>
          <UniformGrid Columns="1" Rows="2" Width="28" HorizontalAlignment="Right" Margin="0,4,4,4">
            <RepeatButton x:Name="MinutesUp" Style="{StaticResource Stepper}" Tag="1" Click="MinutesStep_Click" AutomationProperties.Name="Increase minutes"><Path Data="M 0,4 L 4,0 L 8,4" Stroke="{StaticResource Accent}" StrokeThickness="1.5"/></RepeatButton>
            <RepeatButton x:Name="MinutesDown" Style="{StaticResource Stepper}" Tag="-1" Click="MinutesStep_Click" AutomationProperties.Name="Decrease minutes"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource Accent}" StrokeThickness="1.5"/></RepeatButton>
          </UniformGrid>
        </Grid>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <Label Content="_Seconds" Target="{Binding ElementName=SecondsInput}"/>
        <Grid>
          <TextBox x:Name="SecondsInput" FontSize="24" MaxLength="2" Padding="10,8,38,8" PreviewKeyDown="TimeInput_KeyDown" AutomationProperties.Name="Seconds remaining"/>
          <UniformGrid Columns="1" Rows="2" Width="28" HorizontalAlignment="Right" Margin="0,4,4,4">
            <RepeatButton x:Name="SecondsUp" Style="{StaticResource Stepper}" Tag="1" Click="SecondsStep_Click" AutomationProperties.Name="Increase seconds"><Path Data="M 0,4 L 4,0 L 8,4" Stroke="{StaticResource Accent}" StrokeThickness="1.5"/></RepeatButton>
            <RepeatButton x:Name="SecondsDown" Style="{StaticResource Stepper}" Tag="-1" Click="SecondsStep_Click" AutomationProperties.Name="Decrease seconds"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource Accent}" StrokeThickness="1.5"/></RepeatButton>
          </UniformGrid>
        </Grid>
      </StackPanel>
    </Grid>
    <TextBlock x:Name="RangeHint" Style="{StaticResource Caption}" Margin="0,10,0,0" />
    <TextBlock x:Name="ValidationText" Foreground="#A34332" AutomationProperties.LiveSetting="Polite" Margin="0,12,0,0" />
    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/><Button x:Name="ApplyButton" Grid.Column="2" Content="Set Time" Style="{StaticResource Primary}" IsDefault="True" Click="Apply_Click"/></Grid>
  </StackPanel>
</Window>
