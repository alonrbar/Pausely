<Window Style="{StaticResource FramelessWindow}" x:Class="Pausely.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pausely" Width="558" Height="728" MinWidth="498" MinHeight="628" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="30,26">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,26">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Image Source="{StaticResource AppLogo}" Width="44" Height="44" Margin="0,4,12,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Pausely logo" />
          <StackPanel>
            <TextBlock Text="Pausely" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="A little pause. A better day." Style="{StaticResource Caption}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Settings" Click="Settings_Click" Padding="10,9" Margin="0,0,6,0" />
          <Button Content="−" Style="{StaticResource WindowControl}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize Pausely" />
          <Button Content="×" Style="{StaticResource WindowControl}" Click="Close_Click" ToolTip="Close to tray" AutomationProperties.Name="Close Pausely to tray" />
        </StackPanel>
      </Grid>
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel HorizontalAlignment="Stretch">
          <TextBlock x:Name="PhaseLabel" Text="TIME TO FOCUS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
          <Grid Width="228" Height="228" Margin="0,16,0,12">
            <Ellipse Stroke="#EDF1E8" StrokeThickness="9" Margin="6" />
            <Path x:Name="ProgressArc" Stroke="{StaticResource Accent}" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="Countdown" Text="25:00" FontSize="49" FontWeight="Light" HorizontalAlignment="Center" TextWrapping="NoWrap" />
              <TextBlock x:Name="CountdownCaption" Text="until your next pause" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
          <TextBlock x:Name="StatusText" Text="Settle in. We'll take care of the pauses." TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,0,18" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="PrimaryButton" Content="Pause timer" Style="{StaticResource Primary}" Click="Primary_Click" />
            <Button x:Name="BreakButton" Grid.Column="2" Content="Take a break" Click="Break_Click" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Grid.Row="1" Background="#EAF0E4" CornerRadius="14" Padding="18,15">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="YOUR RHYTHM" Style="{StaticResource Caption}" FontWeight="SemiBold"/><TextBlock x:Name="Rhythm" Margin="0,4,0,0" FontWeight="SemiBold"/></StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="BREAKS THIS SESSION" Style="{StaticResource Caption}" FontWeight="SemiBold"/><TextBlock x:Name="BreakCount" Text="0 little resets" Margin="0,4,0,0" FontWeight="SemiBold"/></StackPanel>
        </Grid>
      </Border>
      <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="#A34332" Margin="0,12,0,0" Visibility="Collapsed" />
      <TextBlock Grid.Row="3" Text="Close this window to keep Pausely in your tray.&#10;Right-click the tray icon for quick controls or to quit." Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,20,0,0" />
    </Grid>
  </ScrollViewer>
  </DockPanel>
</Window>
